---
slug: my/more_feed.frame
layout: ''
---
{% liquid
  function current_profile = 'modules/community/helpers/current_profile', followships: true, membership: true
  # platformos-check-disable DeprecatedTag
  include 'modules/community/helpers/profile_present_or_redirect', profile: current_profile
  # platformos-check-enable DeprecatedTag

  assign page = context.params.page | to_positive_integer: 1
  function list = 'modules/community/queries/activities/search_with_records', feed: 'user-private', feed_id: current_profile.id, limit: 9, page: page, uuid: null

  theme_render_rc 'components/pages/feed', list: list, current_profile: current_profile, user: current_profile, self: true, frame: true, page: page
%}
