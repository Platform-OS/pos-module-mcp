---
method: post
---

{% liquid
  function current_profile = 'modules/community/helpers/current_profile'
  # platformos-check-disable DeprecatedTag
  include 'modules/community/helpers/profile_present_or_not_authenticated', profile: current_profile
  # platformos-check-enable DeprecatedTag

  assign data = context.params
  hash_assign data['l_id'] = data['l_id'] | default: current_profile.id
  hash_assign data['type'] = 'relationship'
  hash_assign data['created_by_id'] = current_profile.id

  function can = "modules/community/helpers/can", actor: current_profile, do: 'create', object: data
  unless can.valid
    # platformos-check-disable DeprecatedTag
    include 'modules/community/json/shared/not_authenticated'
    # platformos-check-enable DeprecatedTag
    break
  endunless

  function object = 'modules/community/commands/relationships/find_or_create', object: data

  if object.valid and object.created
    assign event_payload = null | hash_merge: l_id: object.l_id, r_id: object.r_id, relationship_id: object.id
    function _ = 'modules/core/commands/events/publish', type: 'relationship_created', object: event_payload, delay: 0, max_attempts: null
    function _event = 'modules/community/commands/core_events/factory/create', relation: object, _event: null
  endif

  render 'modules/community/json/shared/show', object: object
%}
