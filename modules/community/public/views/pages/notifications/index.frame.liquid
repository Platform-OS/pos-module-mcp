---
slug: notifications.frame
layout: ''
---
{% liquid
  assign full = context.params.full
  function current_profile = 'modules/community/helpers/current_profile', membership: true
  # platformos-check-disable DeprecatedTag
  include 'modules/community/helpers/profile_present_or_redirect', profile: current_profile, allow_uncompleted: true
  # platformos-check-enable DeprecatedTag

  assign page = context.params.page | to_positive_integer: 1

  if full
    function list = 'modules/community/queries/activities/search', feed: 'user-notifications', feed_id: current_profile.id, limit: 5, page: page
    theme_render_rc 'components/organisms/notifications-dropdown', current_profile: current_profile, list: list
  else
    function list = 'modules/community/queries/activities/search', feed: 'user-notifications', feed_id: current_profile.id, limit: 10, page: page
    theme_render_rc 'components/molecules/notifications-frame', current_profile: current_profile, list: list
  endif
%}
