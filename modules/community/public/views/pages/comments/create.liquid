---
slug: comments
method: post
---
{% liquid
  function current_profile = 'modules/community/helpers/current_profile', membership: true
  # platformos-check-disable DeprecatedTag
  include 'modules/community/helpers/profile_present_or_redirect', profile: current_profile
  # platformos-check-enable DeprecatedTag

  if context.params.comment.commentable_type == 'post' or context.params.comment.commentable_type == 'modules/community/post'
    function post = 'modules/community/queries/posts/find_with_group', id: context.params.comment.commentable_id
    # platformos-check-disable DeprecatedTag
    include 'modules/user/helpers/can_do_or_unauthorized', entity: post.group, do: 'comment', requester: current_profile, access_callback: 'modules/community/can/groups', anonymous_return_to: null, redirect_anonymous_to_login: false, forbidden_partial: null
    # platformos-check-enable DeprecatedTag
  endif

  function object = 'modules/community/commands/comments/create', object: context.params.comment, current_profile: current_profile
  if object.valid
    assign event_payload = null | hash_merge: creator_id: current_profile.id, comment_id: object.id, commentable_id: context.params.comment.commentable_id
    function _ = 'modules/core/commands/events/publish', type: 'comment_created', object: event_payload, delay: 0, max_attempts: null
    # platformos-check-disable DeprecatedTag
    include 'modules/community/helpers/redirect_to', url: context.params.return_to
    # platformos-check-enable DeprecatedTag
  else
    # platformos-check-disable DeprecatedTag
    include 'modules/community/helpers/redirect_to', url: context.params.return_to, error: 'modules/community/comments.create_failed'
    # platformos-check-enable DeprecatedTag
  endif
%}
