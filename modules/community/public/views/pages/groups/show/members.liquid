---
slug: groups/:id/members
layout: modules/community/community
---
{% liquid
  function current_profile = 'modules/community/helpers/current_profile', membership: true, followships: true

  assign group_id = context.params.id | split: '-' | last
  function group = 'modules/community/queries/groups/find', id: group_id, with_owner: true, current_profile: current_profile
  # platformos-check-disable DeprecatedTag
  include 'modules/user/helpers/can_do_or_unauthorized', entity: group, do: 'see_meta', requester: current_profile, access_callback: 'modules/community/can/groups', anonymous_return_to: null, redirect_anonymous_to_login: false, forbidden_partial: null
  # platformos-check-enable DeprecatedTag

  function list = 'modules/community/queries/relationships/search_by_right', limit: 20, name: 'membership', r_id: group_id, include_related: true, accepted: true, approved: true, l_id: null, not_l_id: null
  assign list = list.results | map: 'l'

  theme_render_rc 'components/templates/groups', section: 'members', group: group, current_profile: current_profile, list: list, tab: 'members', context: context
%}
