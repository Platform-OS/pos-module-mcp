---
slug: groups/:id/relationships
layout: modules/community/community
---

{% liquid
  function current_profile = 'modules/community/helpers/current_profile', membership: true

  assign group_id = context.params.id | split: '-' | last
  function group = 'modules/community/queries/groups/find', id: group_id, with_owner: false, current_profile: current_profile
  # platformos-check-disable DeprecatedTag
  include 'modules/user/helpers/can_do_or_unauthorized', entity: group, do: 'edit', requester: current_profile, access_callback: 'modules/community/can/groups', anonymous_return_to: null, redirect_anonymous_to_login: false, forbidden_partial: null
  # platformos-check-enable DeprecatedTag

  function owners = 'modules/community/queries/relationships/search_by_right_group', name: 'owner', r_id: group_id, include_related: true, keyword: context.params.keyword, limit: null, page: null, l_id: null, not_l_id: null, accepted: null, approved: null
  assign not_l_id = owners.results | map: 'l_id'
  if not_l_id == blank
    assign not_l_id = '["blank"]' | parse_json
  endif
  function members = 'modules/community/queries/relationships/search_by_right_group', limit: 20, page: context.params.page, name: 'membership', r_id: group_id, not_l_id: not_l_id, include_related: true, keyword: context.params.keyword, l_id: null, accepted: null, approved: null

  render 'modules/community/migrated/groups/manage/relationships', group: group, current_profile: current_profile, members: members, owners: owners, params: null
%}
