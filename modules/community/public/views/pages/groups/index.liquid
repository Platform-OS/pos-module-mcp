---
slug: groups
layout: modules/community/community
---

{% liquid
  function current_profile = 'modules/community/helpers/current_profile', membership: true
  # platformos-check-disable DeprecatedTag
  include 'modules/community/helpers/profile_present_or_redirect', profile: current_profile
  # platformos-check-enable DeprecatedTag
  
  function filters = 'modules/community/queries/groups/filters', params: context.params
  function list = 'modules/community/queries/groups/search', limit: 6, page: filters.page, keyword: filters.keyword, sort: filters.sort, meta_visible: 'anonymous', current_profile: current_profile, owner_id: null, relation_name: null, not_name: null, not_type: null, not_ids: null, ask_to_join: null, with_owner: null, id: null
  if current_profile and filters.page == 1
    assign public_ids = list.results | map: 'id'
    function member_list = 'modules/community/queries/groups/search_for_member_or_invited', limit: 100, member_id: current_profile.id, not_ids: public_ids, current_profile: current_profile
    assign combined_results = list.results | concat: member_list.results
    hash_assign list['results'] = combined_results
  endif
  function _ = 'modules/community/helpers/extend_context', tags: true, photo_presign: true, group: null

  theme_render_rc 'components/pages/group-listing', list: list, filters: filters
%}
