---
slug: groups/:id/frame
layout: ''
---
{% liquid
  function current_profile = 'modules/community/helpers/current_profile', membership: true
  # platformos-check-disable DeprecatedTag
  include 'modules/community/helpers/profile_present_or_redirect', profile: current_profile
  # platformos-check-enable DeprecatedTag

  assign group_id = context.params.id | split: '-' | last
  function group = 'modules/community/queries/groups/find', id: group_id, with_owner: true, current_profile: null
  # platformos-check-disable DeprecatedTag
  include 'modules/user/helpers/can_do_or_unauthorized', entity: group, do: 'see_content', requester: current_profile, access_callback: 'modules/community/can/groups', anonymous_return_to: null, redirect_anonymous_to_login: false, forbidden_partial: null
  # platformos-check-enable DeprecatedTag

  assign page = context.params.page | to_positive_integer: 1
  function list = 'modules/community/queries/activities/search_with_records', feed: 'group-public', feed_id: group.id, limit: 20, page: page, uuid: null

  render 'modules/community/groups/activity', group: group, current_profile: current_profile, page: page, list: list, namespace: null
%}
