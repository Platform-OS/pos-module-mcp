---
slug: events/:id
method: delete
---
{% liquid
  function current_profile = 'modules/community/helpers/current_profile'
  # platformos-check-disable DeprecatedTag
  include 'modules/community/helpers/profile_present_or_redirect', profile: current_profile
  # platformos-check-enable DeprecatedTag

  assign event_id = context.params.id | split: '-' | last
  function event = 'modules/community/queries/events/find', id: event_id, with_owner: true, current_profile: current_profile
  # platformos-check-disable DeprecatedTag
  include 'modules/user/helpers/can_do_or_unauthorized', entity: event, do: 'delete', requester: current_profile, access_callback: 'modules/community/can/events', anonymous_return_to: null, redirect_anonymous_to_login: false, forbidden_partial: null
  # platformos-check-enable DeprecatedTag

  if event
    function object = 'modules/community/commands/events/delete', event: event
    if object.valid
      assign event_payload = null | hash_merge: event_object: event, actor_id: current_profile.id
      function _ = 'modules/core/commands/events/publish', type: 'event_deleted', object: event_payload, delay: 0, max_attempts: null

      # platformos-check-disable DeprecatedTag
      include 'modules/community/helpers/redirect_to', url: '/admin/community/events' , notice: 'modules/community/events.deleted'
      # platformos-check-enable DeprecatedTag
    else
      # platformos-check-disable DeprecatedTag
      include 'modules/community/helpers/redirect_to', url: '/admin/community/events', notice: 'modules/community/common.delete_failed'
      # platformos-check-enable DeprecatedTag
    endif
  endif
%}
