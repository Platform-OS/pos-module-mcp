{% liquid
  function direction = 'modules/community/helpers/text_direction', lang: context.language
  if context.current_user
    response_headers '{ "Cache-Control": "no-store", "Pragma": "no-cache" }'
  endif
%}

<!DOCTYPE html>

<html dir="{{ direction }}" lang="{{ context.language }}" class="pos-app">
  <head>

    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <meta name="csrf-param" content="authenticity_token">
    <meta name="csrf-token" content="{{ context.authenticity_token }}">

    {% liquid
      function favicon = 'modules/community/queries/photos/search', photo_type: 'favicon', object_uuid: null, limit: null
      assign default_favicon = 'modules/community/favicon/favicon.ico' | asset_url
      assign favicon = favicon.results.first.photo.versions.sm | default: default_favicon
    %}

    <link rel="icon" href="{{ favicon }}" sizes="32x32">
    <link rel="icon" href="{{ 'modules/community/favicon/favicon.svg' | asset_url }}" type="image/svg+xml">
    <link rel="apple-touch-icon" href="{{ 'modules/community/favicon/apple-touch-icon.png' | asset_url }}">

    {%- capture meta_description -%}{%- yield meta_description -%}{%- endcapture -%}
    {%- capture meta_image -%}{%- yield meta_image -%}{%- endcapture -%}
    {% liquid
      assign default_description = 'modules/community/seo.meta_description' | t: default: ''
      function social_sharing_image = 'modules/community/queries/photos/search', photo_type: 'social_sharing_image', object_uuid: null, limit: null
      # platformos-check-disable MissingAsset
      assign default_share_image = 'modules/community/images/share.png' | asset_url
      # platformos-check-enable MissingAsset
      assign share_image = meta_image | default: social_sharing_image.results.first.photo.versions.md | default: default_share_image
    %}

    {% if meta == blank %}
      <title>{{ 'app.title' | t }}</title>

      <meta property="og:title" content="{{ 'app.title' | t | strip_html }}">
      <meta property="og:type" content="website">
      <meta property="og:url" content="{{ context.location.url }}">
      <meta property="og:image" content="{{ share_image }}">
      <meta property="og:locale" content="{{ context.language }}">
      <meta property="og:description" content="{{ meta_description | default: default_description | strip_html }}">
      <meta name="twitter:card" content="summary_large_image">
      <meta name="twitter:title" content="{{ 'app.title' | t | strip_html }}">
      <meta name="twitter:description" content="{{ meta_description | default: default_description | strip_html }}">
      <meta name="twitter:image" content="{{ share_image }}">
    {% else %}
      {% print meta %}
    {% endif %}

    {% comment %}
      manually including common styling in this layout to avoid loading unnecessary styles and scripts from community layout
    {% endcomment %}
    <link rel="stylesheet" href="{{ 'modules/common-styling/style/pos-reset.css' | asset_url }}">
    <link rel="stylesheet" href="{{ 'modules/common-styling/style/pos-config.css' | asset_url }}">
    <link rel="stylesheet" href="{{ 'modules/common-styling/style/pos-typography.css' | asset_url }}">
    <link rel="stylesheet" href="{{ 'modules/common-styling/style/pos-button.css' | asset_url }}">
    <link rel="stylesheet" href="{{ 'modules/common-styling/style/pos-toast.css' | asset_url }}">
    <link rel="stylesheet" href="{{ 'modules/common-styling/style/pos-forms.css' | asset_url }}">
    <link rel="stylesheet" href="{{ 'modules/common-styling/style/pos-page.css' | asset_url }}">

    <link rel="stylesheet" href="{{ 'modules/user/style/pos-user-form.css' | asset_url }}">

    <link rel="stylesheet" href="{{ 'modules/community/style/pos-community-config.css' | asset_url }}">
    <link rel="stylesheet" href="{{ 'modules/community/style/pos-community-button.css' | asset_url }}">
    <link rel="stylesheet" href="{{ 'modules/community/style/pos-community-layout.css' | asset_url }}">
    <link rel="stylesheet" href="{{ 'modules/community/style/pos-community-user-forms.css' | asset_url }}">

    <link rel="stylesheet" href="{{ 'style/community-user-forms.css' | asset_url }}">

    {% if context.location.pathname == '/onboarding' %}
      <link rel="stylesheet" href="{{ 'modules/common-styling/style/pos-tag.css' | asset_url }}">
      <link rel="stylesheet" href="{{ 'modules/community/style/pos-community-onboarding.css' | asset_url }}">
    {% endif %}

  </head>

  <body>

    <main>
      {{ content_for_layout }}
    </main>

  </body>
</html>