<!DOCTYPE html>

{% liquid
  function direction = 'modules/community/helpers/text_direction', lang: context.language
  if context.current_user
    response_headers '{ "Cache-Control": "no-store", "Pragma": "no-cache" }'
  endif
%}

<html dir="{{ direction }}" lang="{{ context.language }}" class="overflow-y-scroll scroll-smooth">
  <head>
    <script type="importmap">
      {
        "imports": {
          {%- comment -%}platformos-check-disable MissingAsset{%- endcomment -%}
          "/": "{{ 'modules/chat/js/' | asset_url }}",
          {%- comment -%}platformos-check-enable MissingAsset{%- endcomment -%}
          "pos-chat.js": "{{ 'modules/chat/js/pos-chat.js' | asset_url }}",
          "pos-chat-consumer.js": "{{ 'modules/chat/js/pos-chat-consumer.js' | asset_url }}",
          "pos-chat-csrfToken.js": "{{ 'modules/chat/js/pos-chat-csrfToken.js' | asset_url }}",
          "pos-chat-notifications.js": "{{ 'modules/chat/js/pos-chat-notifications.js' | asset_url }}",
          "./": "./"
        }
      }
    </script>

    {% capture meta %}{% yield 'metatags' %}{% endcapture %}
    {% render 'modules/community/layout/head', meta: meta, lang: context.language %}
    {% render 'modules/community/layout/assets_styles' %}
    {%- capture canonical_url -%}{%- yield 'canonical' -%}{%- endcapture -%}
    {% if canonical_url != blank %}
      <link rel="canonical" href="https://{{ context.location.host }}{% print canonical_url | strip %}" />
    {% endif %}
    {% render 'modules/community/layout/js_global_variables', current_profile: context.exports.current_profile %}

    {% render 'modules/common-styling/init', reset: null %}
    <link rel="stylesheet" href="{{ 'modules/chat/style/pos-chat-inbox.css' | asset_url }}">
    <link rel="stylesheet" href="{{ 'modules/community/style/pos-community-config-tailwind.css' | asset_url }}">
    <link rel="stylesheet" href="{{ 'modules/community/style/pos-community-config.css' | asset_url }}">
    <link rel="stylesheet" href="{{ 'modules/community/style/pos-community-chat.css' | asset_url }}">
    <link rel="stylesheet" href="{{ 'modules/community/style/pos-community-user-forms.css' | asset_url }}">
    <link rel="stylesheet" href="{{ 'modules/user/style/pos-user-form.css' | asset_url }}">
    {% render 'modules/community/layout/assets_app' %}
    <link rel="stylesheet" href="{{ 'modules/community/style/pos-community-notification.css' | asset_url }}">
  </head>

  <body class="font-sans antialiased leading-normal text-normal bg-base scroll-smooth">
    <div class="flex flex-col min-h-screen">
      {% theme_render_rc 'components/organisms/header', profile: context.exports.current_profile, context: context %}
      {% if context.session.original_user_id %}
        {% theme_render_rc 'components/organisms/logging_back', profile: context.exports.current_profile, context: context %}
      {% endif %}

      <main class="flex flex-col flex-1 flex-grow relative mt-10">

        {{ content_for_layout }}

        {% liquid
          function flash = 'modules/core/commands/session/get', key: 'sflash', clear: null
          if context.location.pathname != flash.from or flash.force_clear
            function _ = 'modules/core/commands/session/clear', key: 'sflash'
          endif
          theme_render_rc 'components/molecules/flashes', params: flash
        %}
      </main>

      {% theme_render_rc 'components/organisms/footer', profile: context.exports.current_profile %}
      {% render 'modules/community/layout/scripts' %}
    </div>

    {% render 'modules/community/layout/assets_scripts' %}
    {% yield 'custom_scripts' %}
  </body>
</html>
