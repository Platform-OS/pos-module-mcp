---
metadata:
  name: Group relationships list
  params:
    title: ''
    list: {}
    profile: {}
    show_make_admin: true
    show_remove_admin: true
    show_remove_group: true
    current_profile: {}
  styleguide:
    title: "Admins"
    list:
      total_entries: 3
      results:
        - l:
            first_name: "Thomas"
            last_name: "May"
            job_title: "Bank Auditor"
            employer: "Citigroup"
---
{% liquid
  assign title = title | default: params.title
  assign list = list | default: params.list
%}
{% if list.results.size > 0 %}

  <header>
    <div><h3 class="font-bold capitalize mb-6">{{ title }}</h3></div>
  </header>

  <div>
  {% for relation in list.results %}

    {% function profile = 'modules/user/queries/profiles/find', id: relation.l.id, uuid: null, user_id: null, first_name: null, last_name: null %}
    {% if show_remove_admin %}
      {% assign remove_admin_popup_id = 'remove-admin-' | append: relation.id %}
      {% capture popup_remove_admin_content %}
        <div class="pb-4">
          {{ profile.name }} will no longer have admin permissions but will still be a member of the group.
        </div>
        <form action="/groups/{{ group.id }}/remove-admin" method="post">
          {% render 'modules/core/helpers/authenticity_token', authenticity_token: context.authenticity_token, token: context.authenticity_token %}
          <input type="hidden" name="_method" value="delete">
          <input type="hidden" name="relation_id" value="{{ relation.id }}">
          <input type="hidden" name="return_to" value="/groups/{{group.id}}/relationships">

          {% theme_render_rc 'components/atoms/button', content: 'Remove admin permissions', type: 'submit' %}
          {% assign button_attributes = {"data-popup-open-id": remove_admin_popup_id} %}
          {% theme_render_rc 'components/atoms/button', content: 'Cancel', weight: "secondary", attributes: button_attributes %}
        </form>
      {% endcapture %}
      {% theme_render_rc 'components/molecules/popup', popup_id: remove_admin_popup_id, title: 'Remove Admin Permissions', content: popup_remove_admin_content, closeIcon: true %}
    {% endif %}

    {% if show_make_admin %}
      {% assign make_admin_popup_id = 'make-admin-' | append: relation.id %}
      {% capture popup_make_admin_content %}
        <div class="pb-4">
          As an admin, {{ profile.name }} will be able to edit the group info and manage the user permissions.
        </div>
        <form action="/groups/{{ group.id }}/set-admin" method="post">
          {% render 'modules/core/helpers/authenticity_token', authenticity_token: context.authenticity_token, token: context.authenticity_token %}
          <input type="hidden" name="user_id" value="{{ relation.l_id }}">
          <input type="hidden" name="return_to" value="/groups/{{group.id}}/relationships">

          {% theme_render_rc 'components/atoms/button', content: 'Make admin', type: 'submit' %}
          {% assign button_attributes = {"data-popup-open-id": make_admin_popup_id} %}
          {% theme_render_rc 'components/atoms/button', content: 'Cancel', weight: "secondary", attributes: button_attributes %}
        </form>
      {% endcapture %}
      {% theme_render_rc 'components/molecules/popup', popup_id: make_admin_popup_id, title: 'Make Admin', content: popup_make_admin_content, closeIcon: true %}
    {% endif %}

    {% if show_remove_group %}
      {% assign remove_group_popup_id = 'remove-group-' | append: relation.id %}
      {% capture popup_remove_from_group_content %}
        <div class="pb-4">
          Are you sure you want to remove {{ profile.name }} from the group? The user will not be notified of this change.
        </div>
        <form action="/groups/{{ group.id }}/remove-member" method="post">
          {% render 'modules/core/helpers/authenticity_token', authenticity_token: context.authenticity_token, token: context.authenticity_token %}
          <input type="hidden" name="_method" value="delete">
          <input type="hidden" name="user_id" value="{{ relation.l_id }}">
          <input type="hidden" name="return_to" value="/groups/{{group.id}}/relationships">

          {% assign button_text = 'modules/community/groups.relationships.remove_from_group' | t %}
          {% theme_render_rc 'components/atoms/button', content: button_text, type: 'submit' %}
          {% assign button_attributes = {"data-popup-open-id": remove_group_popup_id} %}
          {% theme_render_rc 'components/atoms/button', content: 'Cancel', weight: "secondary", attributes: button_attributes %}
        </form>
      {% endcapture %}
      {% theme_render_rc 'components/molecules/popup', popup_id: remove_group_popup_id, title: 'Remove From Group', content: popup_remove_from_group_content, closeIcon: true %}
    {% endif %}

    <div class="flex flex-col md:flex-row w-full mb-4 pb-4 border-b last:border-0">

      <div class="md:w-1/3">
        <a class="inline-flex font-bold items-center gap-2" href="/profile/{{ profile.slug }}">
          {% theme_render_rc 'components/atoms/avatar', size: 'l', name: profile.name, imageSrc: profile.avatar.photo.versions.m %}
          {{ profile.name }}
        </a>
      </div>

      <div class="md:w-1/3 pb-4">
        {% if profile.job_title %}
          <div>{{ profile.job_title }}</div>
        {% endif %}
        {% if profile.employer %}
          <div> at {{ profile.employer }}</div>
        {% endif %}
      </div>

      <div class="md:w-1/3">
        <div class="flex items-center justify-between md:justify-end gap-4">
          <div>
            <span class="md:hidden">{{ 'modules/community/groups.relationships.r_accepted_at' | t }}:</span>
            {% if relation.r_accepted_at == blank %}
              {% theme_render_rc 'modules/community/components/molecules/group_approve_button', group: group, relation: relation %}
            {% else %}
              <time class="timeago" datetime="{{ relation.r_accepted_at }}">{{ relation.r_accepted_at }}</time>
            {% endif %}
          </div>
          {% liquid
            assign message_text = 'modules/chat/message' | t
            assign message_url = "/inbox/?to_uuid=" | append: profile.uuid

            assign message_disabled = false
            if profile.id == current_profile.id
              assign message_disabled = true
            endif
            theme_render_rc 'components/atoms/button', weight: 'secondary', disabled: message_disabled, href: message_url, content: message_text
          %}
          <div class="w-8">
          {% if show_remove_admin or show_make_admin or show_remove_group %}
            {% capture dropdown_content %}
              <ul class="whitespace-nowrap">
                {% if show_remove_admin %}
                  <li data-popup-open-id="{{remove_admin_popup_id}}" class="cursor-pointer py-3 px-7 text-normal hover:bg-interactive-graphic hover:text-inverted transition-colors">Remove admin permissions</li>
                {% endif %}
                {% if show_make_admin %}
                  <li data-popup-open-id="{{make_admin_popup_id}}" class="cursor-pointer py-3 px-7 text-normal hover:bg-interactive-graphic hover:text-inverted transition-colors">Make Admin</li>
                {% endif %}
                {% if show_remove_group %}
                  <li data-popup-open-id="{{remove_group_popup_id}}" class="cursor-pointer py-3 px-7 text-normal hover:bg-interactive-graphic hover:text-inverted transition-colors">Remove From Group</li>
                {% endif %}
              </ul>
            {% endcapture %}
            {% capture dropdown_label %}
              {% theme_render_rc 'components/atoms/icon', name: 'menuHorizontal', class: 'w-6 h-6 text-interactive-graphic' %}
            {% endcapture %}
            {% theme_render_rc 'components/molecules/dropdown', label: dropdown_label, content: dropdown_content, dropdown_classes: 'px-0' %}
          {% endif %}
          </div>
        </div>
      </div>
    </div>
  {% endfor %}
  </div>

  {% theme_render_rc 'components/molecules/pagination-old', form: 'search-form' collection: list, current_page: page %}
{% endif %}
