---
metadata:
  name: Event card
  params:
    owner: {}
    name: ''
    location: ''
    date: ''
    url: ''
    type:
      - online
      - local
    tags: []
    description: ''
    members: ''
    imgSrc: ''
    classes: ''
  styleguide:
    - name: 'Stock Management Seminar'
      location: 'Zoom Meeting'
      date: 'WED, Dec 14 • 2:00 PM'
      url: 'http://zoom.zoom'
      type: 'online'
      tags: ['food' , 'longertaghere']
      description: Introducing an innovative and highly automated treatment line for the innovative and highly automated treatment line for the'
      members: '76'
      imgSrc: 'https://picsum.photos/300/180?random=1'
      classes: 'w-80'
    - name: 'Alumni Winter Gathering '
      location: 'Bellevue WA, 2223 112th Ave NE STE 200'
      date: 'WED, Dec 14 • 2:00 PM'
      url: 'http://zoom.zoom'
      type: 'local'
      tags: ['food' , 'longertaghere']
      description: Introducing an innovative and highly automated treatment line for the innovative and highly automated treatment line for the'
      members: '76'
      imgSrc: 'https://picsum.photos/300/180?random=2'
      classes: 'w-80'
---
{% liquid
  assign owner = owner | default: params.owner
  assign name = name | default: params.name
  assign url = url | default: params.url
  assign location = location | default: params.location
  assign date = date | default: params.date
  assign type = type | default: params.type
  assign tags = tags | default: params.tags
  assign description = description | default: params.description
  assign members = members | default: params.members
  assign placeholder_img = 'modules/community/images/Placeholder_image.png' | asset_url
  assign img_src = img_src | default: params.imgSrc | default: placeholder_img
  assign classes = classes | default: params.classes

  if type == "local"
    assign icon = "pin"
  else
    assign icon = "globe"
  endif

  assign icon_classes = 'w-3 h-3 mr-2 text-confirmation'
  assign classes = classes | append: ' overflow-hidden p-0 '
%}
{% capture content %}
  <div class="flex flex-col justify-between h-full" data-tc="card-element">
    <div class="flex flex-col justify-start">
      <div class="relative">
        <div class="absolute right-2 top-2 px-2 flex items-center align-center h-6 rounded border border-divider bg-highlighted">
          <div>
            {% theme_render_rc 'components/atoms/icon', name: icon, class: icon_classes %}
          </div>
          <div data-tc="eventType">
            {{ type }}
          </div>
        </div>
        <a href="{{ url }}"><img src="{{ img_src }}" class="w-full h-48 object-cover" width="800" height="192"></a>
      </div>
      <div class="p-6" data-tc="eventDetails">
        <div class="font-bold">{{ date }}</div>
        <div class="mt-1">
          <a href="{{ url }}">
            {% liquid
              theme_render_rc 'components/atoms/heading', content: name, level: 4
            %}
          </a>
        </div>

        {% if owner != blank %}
          <div class="pt-3">
            {% function owner_url = 'modules/community/helpers/link_to', object: owner, type: 'profile' %}
            created by <a href="{{ owner_url }}">{{ owner.name }}</a>
          </div>
        {% endif %}

        <div class="text-xs pb-3 pt-1">{{ location }}</div>
        <div class="pb-3">
          {% for tag in tags %}
            <a href="/events?tags[]={{ tag }}">
              {% liquid
                assign tagtext = "#" | append: tag
                theme_render_rc 'components/molecules/chip', content: tagtext, variant: 'clickable', classes: 'mt-1'
              %}
            </a>
          {% endfor %}
        </div>
        <div>{{ description | truncatewords: 10 }}</div>
      </div>
    </div>
    <div class="flex justify-between p-6">
      <div class="flex items-center pr-2">
        {% theme_render_rc 'components/atoms/icon', name: 'users', class: 'w-5 h-5' %}
        <span class="px-2">{{ members }} going</span>
      </div>
      {% theme_render_rc 'components/atoms/button', content: 'More info', href: url %}
    </div>
  </div>
{% endcapture %}

{% theme_render_rc 'components/atoms/card', content: content, classes: classes %}
