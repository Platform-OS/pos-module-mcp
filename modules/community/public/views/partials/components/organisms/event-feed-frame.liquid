  {% if list.total_entries > 0 %}
    {% liquid
      for activity in list.results
        theme_render_rc 'components/organisms/feed-entry', payload: activity.payload, current_profile: current_profile, context: context, can_post: can_post
      endfor

      if list.has_next_page
        assign url = '/events/' | append: event.id | append: '/frame'
      endif
    %}
    {% if list.has_next_page %}
      <button
        id="pos-community-load-feed-more"
        class="pos-button"
        data-load-content="{{ url }}?page={{ page | default: 1 | plus: 1 }}"
        data-load-where="last"
        data-load-target="#pos-community-feed-posts"
        disabled
      >{{ 'modules/community/app.show_more' | t }}</button>
    {% endif %}
  {% endif %}