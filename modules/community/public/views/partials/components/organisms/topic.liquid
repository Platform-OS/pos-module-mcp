---
metadata:
  name: Topic
  params:
    readers: ''
    comments: ''
    icon: ''
    title: ''
    classes: ''
---
{% liquid
  assign readers = readers | default: params.readers
  assign classes = classes | default: params.classes
  assign comments = comments | default: params.comments
  assign icon = icon | default: params.icon
  assign title = title | default: params.title
%}

{% capture card_content %}

  <div class="flex flex-col justify-center items-center pt-4">
    {% theme_render_rc 'components/atoms/icon', name: icon, class: 'w-24 h-24 md:w-12 md:h-12 lg:w-24 lg:h-24' %}
    {% theme_render_rc 'components/atoms/heading', content: title, classes: 'text-interactive-text pb-4 pt-7 md:text-xs lg:text-xl', level: 4 %}
  </div>

  <div class="flex justify-end mb-1 mt-auto">
    <div class="flex">
      <div class="flex items-center pr-2">
        {% theme_render_rc 'components/atoms/icon', name: 'user', class: 'w-5 h-5 md:w-2 md:h-2 lg:w-5 lg:h-5' %}
        <span class="px-2">{{readers}}</span>
      </div>
      <div class="flex items-center">
        {% theme_render_rc 'components/atoms/icon', name: 'commentText', class: 'w-5 h-5 md:w-2 md:h-2 lg:w-5 lg:h-5' %}
        <span class="px-2">{{comments}}</span>
      </div>
    </div>
  </div>
{% endcapture %}

{% liquid
  assign card_params = null | hash_merge: content: card_content, classes: classes, variant: variant
%}
{% theme_render_rc 'components/atoms/card', params: card_params %}
