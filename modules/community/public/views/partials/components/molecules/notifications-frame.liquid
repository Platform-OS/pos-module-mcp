{% if list.total_entries > 0 %}

  <div
    class="hidden"
    x-init="currentPage++; totalEntries = {{ list.total_entries }}; hasNextPage = {{ list.has_next_page }};"
  ></div>

  {% liquid
    for activity in list.results
      theme_render_rc 'components/molecules/community-notification', payload: activity.payload, current_profile: current_profile, namespace: namespace, context: context, size: 'normal'
    endfor
  %}
{% else %}
  <p class="container my-8 text-lg">{{ 'modules/community/search.no_items_found.title' | t }}</p>
{% endif %}

