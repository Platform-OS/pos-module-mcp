---
metadata:
  name: Event Listing
  params:
    list: {}
    current_profile: {}
    context: {}
---
<section
  x-data="{hasNextPage: false, spinnerFilters: false, totalPages: 0, totalEntries: 0, currentPage: 0, ...frames() }"
>
  <form action="/profile.frame/my-events/{{ context.params.slug2 }}" method="GET" id="my-events-list" x-ref="form">
    <input type="hidden" name="page" x-bind:value="currentPage+1" value="0" x-ref="page">
  </form>

  {% if current_profile.slug == context.params.slug2 %}
      <header class="pos-heading-with-action">
        <h3 class="pos-heading-2">{{ 'modules/community/events.events' | t }}</h3>
        <a href="/events/new" class="pos-button">
          {% render 'modules/common-styling/icon', icon: 'plus', class: null %}
          {{ 'modules/community/events.create' | t }}
        </a>
      </header>
  {% endif %}

  {% if list.total_entries == 0 and skip_empty != true %}
    {% if current_profile.slug != context.params.slug2 %}

      <section class="pos-community-space-empty">
        <div>
          <h3 class="pos-heading-2">{{ 'modules/community/events.profile.other.empty.title' | t }}</h3>
          <p>{{ 'modules/community/events.profile.other.empty.desc' | t }}</p>
        </div>
        {% render 'modules/common-styling/icon', icon: 'calendar', class: null %}
      </section>

    {% else %}

      <section class="pos-community-space-empty">
        <div>
          <h3 class="pos-heading-2">{{ 'modules/community/events.index.empty.title' | t }}</h3>
          <p>{{ 'modules/community/events.no_events_found' | t }}</p>
        </div>
        {% render 'modules/common-styling/icon', icon: 'calendar', class: null %}
      </section>

    {% endif %}
  {% endif %}

  <div x-frames-target="my-list" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
    <div
      class="hidden"
      x-init="currentPage++; totalEntries = {{ list.total_entries }}; hasNextPage = {{ list.has_next_page }};"
    ></div>

    {% for event in list.results %}
      {% liquid
        assign event_type = 'online'
        if event.venue and event.link == blank
          assign event_type = 'local'
        endif
        assign url = '/events/' | append: event.id
        assign event_owner = event.owner.profile
        assign members = event.c__going | plus: event.c__maybe
      %}
      {% render 'modules/community/migrated/events/card',
        owner: event_owner,
        title: event.name,
        url: url,
        location: event.venue,
        date: event.start_date,
        type: event_type,
        summary: event.description,
        members: members,
        image: event.photo.photo
        current_profile: current_profile
      %}
    {% endfor %}
  </div>

  <div
    x-show="hasNextPage"
    class="container mt-8 text-center"
  >
    <button
      type="button"
      x-bind:disabled="spinner"
      disabled
      x-on:click='insert({where: "beforeEnd", target: "my-list"});'
      class="button relative"
    >
      {{ 'modules/community/app.show_more' | t }}
      <div class="card-overlay" x-cloak x-show="spinner" x-transition>
        {% theme_render_rc 'components/atoms/spinner', classes: 'w-8 h-8' %}
      </div>
    </button>
    <hr x-show="currentPage < totalPages" class="border-0 border-t -mt-0.5 relative -z-10 -top-5">
  </div>

  {% if list.suggested.total_entries > 0 %}
    <section
      x-data="{hasNextPage: false, spinnerFilters: false, totalPages: 0, totalEntries: 0, currentPage: 0, ...frames() }"
      class="mt-8"
    >
      {% assign title = 'modules/community/events.suggested.title' | t %}
      {% assign sub_title = 'modules/community/events.suggested.subtitle' | t %}
      {% theme_render_rc 'components/atoms/heading', content: title, level: 2 %}
      <div class="mb-4">
        {{ sub_title }}
      </div>

      <form
        action="/profile.frame/suggested-events/{{ profile.slug }}"
        method="GET"
        id="suggested-events-list"
        x-ref="form"
      >
        <input type="hidden" name="page" x-bind:value="currentPage+1" value="0" x-ref="page">
      </form>

      <div x-frames-target="suggested-list" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
        <div
          class="hidden"
          x-init="currentPage++; totalEntries = {{ list.suggested.total_entries }}; hasNextPage = {{ list.suggested.has_next_page }};"
        ></div>

        {% for event in list.suggested.results %}
          {% liquid
            assign event_type = 'online'
            if event.venue and event.link == blank
              assign event_type = 'local'
            endif
            assign slugified_name = event.name | slugify
            assign url = '/events/' | append: slugified_name | append: '-' | append: event.id
            assign event_owner = event.owner.profile
            assign members = event.c__going | plus: event.c__maybe
          %}
          {% render 'modules/community/migrated/events/card',
            owner: event_owner,
            title: event.name,
            url: url,
            location: event.venue,
            date: event.start_date,
            type: event_type,
            summary: event.description,
            members: members,
            image: event.photo.photo
            current_profile: current_profile
          %}
        {% endfor %}
      </div>

      <div
        x-show="hasNextPage"
        class="container mt-8 text-center"
      >
        <button
          type="button"
          x-bind:disabled="spinner"
          x-on:click='insert({where: "beforeEnd", target: "suggested-list"});'
          class="button relative"
        >
          {{ 'modules/community/app.show_more' | t }}
          <div class="card-overlay" x-cloak x-show="spinner" x-transition>
            {% theme_render_rc 'components/atoms/spinner', classes: 'w-8 h-8' %}
          </div>
        </button>

        <hr x-show="currentPage < totalPages" class="border-0 border-t -mt-0.5 relative -z-10 -top-5">
      </div>
    </section>
  {% endif %}
</section>
