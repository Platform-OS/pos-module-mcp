---
{% liquid
  assign groups = groups | default: params.groups
  assign topics = topics | default: params.topics
  assign posts = posts | default: params.posts
  assign shields = shields | default: params.shields
  assign quicklinks = quicklinks | default: params.quicklinks
%}

{% liquid
  content_for 'metatags'
  theme_render_rc 'home/metatags', lang: lang
  endcontent_for
%}
<div class="-mt-10">
  {% theme_render_rc 'components/organisms/hero' %}
</div>

<section class="container w-full xs:flex relative xs:-top-12 -mb-18">
  {% for shield in shields %}
    {% theme_render_rc 'components/organisms/shield', params: shield %}
  {% endfor %}
</section>

<section class="container w-full xs:flex">
  {% for quicklink in quicklinks %}
    {% theme_render_rc 'components/organisms/quicklink', params: quicklink %}
  {% endfor %}
</section>

<section class="container pb-8">
  {% theme_render_rc 'components/atoms/heading', content: 'Groups to join', classes: 'py-4' %}
  <div class="xs:flex">
    {% for group in groups %}
      <div class="w-full pr-2 pb-4 xs:pb-0">
        {% theme_render_rc 'components/organisms/group-card', params: group %}
      </div>
    {% endfor %}
  </div>
</section>

<section class="bg-supplementary p-4 xs:p-8">
  <div class="container">
    {% theme_render_rc 'components/atoms/heading', content: 'Popular topics', classes: 'pb-6 text-inverted' %}
    <div class="xs:flex">
      {% for topic in topics %}
        <div class="w-full xs:pr-8 pb-4 xs:pb-0">
          {% theme_render_rc 'components/organisms/topic', params: topic %}
        </div>
      {% endfor %}
    </div>
  </div>
</section>

<section class="container py-8">
  {% theme_render_rc 'components/atoms/heading', content: 'Latest posts', classes: 'py-4' %}
  <div class="xs:flex">
    {% for post in posts %}
      <div class="w-full pr-2 pb-4 xs:pb-0">
        {% theme_render_rc 'components/organisms/post', params: post %}
      </div>
    {% endfor %}
  </div>
</section>

<section class="container">
  <div class="xs:flex">
    <div class="w-full xs:w-1/2">
      {%- comment -%}platformos-check-disable MissingAsset, ImgWidthAndHeight{%- endcomment -%}
      <img src="{{ 'modules/community/images/customerservice.png' | asset_url }}" width="600" height="400">
      {%- comment -%}platformos-check-enable MissingAsset, ImgWidthAndHeight{%- endcomment -%}
    </div>
    <div class="w-full xs:w-1/2 xs:p-24">
      {% theme_render_rc 'components/atoms/heading', content: 'Section with image', classes: 'py-4' %}
      <div class="pb-4">
      Lorem ipsum dolor sit amet, consectetur adipiscing elit. Cras turpis arcu, tempor eget ante malesuada, commodo placerat sem. Morbi felis dui, aliquam elementum nisl vitae, auctor suscipit enim.
      </div>
      <div>
      Curabitur vehicula dui vitae neque venenatis, nec ornare felis ornare.
      </div>
    </div>
  </div>
</section>

{%- comment -%}platformos-check-disable MissingAsset{%- endcomment -%}
<section class="py-12 bg-colorful bg-no-repeat bg-center bg-cover text-inverted"
  style="background-image: url({{ 'modules/community/images/cta_bg.svg' | asset_url }})">
{%- comment -%}platformos-check-enable MissingAsset{%- endcomment -%}
  <div class="container items-center text-center">

    <header class="mb-4">
      {% liquid
        assign heading = null | hash_merge: content: 'CTA title', level: 2, tag: 'h2', classes: 'pb-3'
        theme_render_rc 'components/atoms/heading', params: heading

        assign description = null | hash_merge: content: 'description lorem ipsum dolor sit amet', level: 4, tag: 'p', classes: 'mb-6'
        theme_render_rc 'components/atoms/heading', params: description

        assign login = null | hash_merge: weight: 'primary', href: '/sessions/new', content: 'Log in'
        theme_render_rc 'components/atoms/button', params: login
      %}
    </header>

  </div>
</section>

{% theme_render_rc 'home/partners' %}
