---
metadata:
  name: Groups
  params:
    list: []
    current_profile: {}
    profile: {}
    context: {}
---
<section
  x-data="{hasNextPage: false, spinnerFilters: false, totalPages: 0, totalEntries: 0, currentPage: 0, ...frames() }"
>
  <form action="/profile.frame/my-groups" method="GET" id="my-groups-list" x-ref="form">
    <input type="hidden" name="page" x-bind:value="currentPage+1" value="0" x-ref="page">
  </form>


  {% if current_profile.slug == context.params.slug2 %}
    {% if list.total_entries != 0 or context.constants.DEFAULT_GROUP_ID_FOR_NEW_USERS %}
      <header class="pos-heading-with-action">
        <h3 class="pos-heading-2">{{ 'modules/community/groups.my_groups' | t }}</h3>
        <a href="/groups/new" class="pos-button">
          {% render 'modules/common-styling/icon', icon: 'plus', class: null %}
          {{ 'modules/community/groups.new_group' | t }}
        </a>
      </header>
    {% endif %}
  {% endif %}


  {% if list.total_entries == 0 and skip_empty != true and context.constants.DEFAULT_GROUP_ID_FOR_NEW_USERS == blank %}
    {% if current_profile.slug != context.params.slug2 %}
      <section class="pos-community-space-empty">
        <div>
          <h3 class="pos-heading-2">{{ 'modules/community/groups.profiles.empty.title' | t }}</h3>
          <p>{{ 'modules/community/groups.profiles.empty.desc' | t }}</p>
        </div>
        {% render 'modules/common-styling/icon', icon: 'users', class: null %}
      </section>
    {% else %}
      <section class="pos-community-space-empty">
        <div>
          <h3 class="pos-heading-2">{{ 'modules/community/groups.no_groups_found' | t }}</h3>
          <a href="/groups/new" class="pos-button">
            {% render 'modules/common-styling/icon', icon: 'plus', class: null %}
            {{ 'modules/community/groups.new_group' | t }}
          </a>
        </div>
      </section>
    {% endif %}
  {% endif %}

  <div x-frames-target="my-list" class="grid grid-cols-1 md:grid-cols-2 gap-4">
    <div
      class="hidden"
      x-init="currentPage = {{ list.current_page }}; totalEntries = {{ list.total_entries }}; hasNextPage = {{ list.has_next_page }};"
    ></div>

    {% for record in list.results %}
      {% render 'modules/community/migrated/groups/card', group: record, pending_acceptance: null %}
    {% endfor %}
  </div>
  <div
    x-show="hasNextPage"
    class="container mt-8 text-center"
  >
    <button
      type="button"
      x-bind:disabled="spinner"
      x-on:click='insert({where: "beforeEnd", target: "my-list"});'
      class="button relative"
    >
      {{ 'modules/community/app.show_more' | t }}
      <div class="card-overlay" x-cloak x-show="spinner" x-transition>
        {% theme_render_rc 'components/atoms/spinner', classes: 'w-8 h-8' %}
      </div>
    </button>
    <hr x-show="currentPage < totalPages" class="border-0 border-t -mt-0.5 relative -z-10 -top-5">
  </div>
</section>

{% if list.suggested.total_entries > 0 %}
  <section
    x-data="{hasNextPage: false, spinnerFilters: false, totalPages: 0, totalEntries: 0, currentPage: 0, ...frames() }"
    class="mt-8"
  >
    <header class="pos-heading-with-action">
      <h3 class="pos-heading-2">{{ 'modules/community/groups.suggested_groups' | t }}</h3>
    </header>

    <form
      action="/profile.frame/suggested-groups/{{ profile.slug }}"
      method="GET"
      id="suggested-groups-list"
      x-ref="form"
    >
      <input type="hidden" name="page" x-bind:value="currentPage+1" value="0" x-ref="page">
    </form>

    <div x-frames-target="suggested-list" class="grid grid-cols-1 md:grid-cols-2 gap-4">
      <div
        class="hidden"
        x-init="currentPage = {{ list.suggested.current_page }}; totalEntries = {{ list.suggested.total_entries }}; hasNextPage = {{ list.suggested.has_next_page }};"
      ></div>

      {% for record in list.suggested.results %}
        {% render 'modules/community/migrated/groups/card', group: record, pending_acceptance: null %}
      {% endfor %}
    </div>

    <div
      x-show="hasNextPage"
      class="container mt-8 text-center"
    >
      <button
        type="button"
        x-bind:disabled="spinner"
        x-on:click='insert({where: "beforeEnd", target: "suggested-list"});'
        class="button relative"
      >
        {{ 'modules/community/app.show_more' | t }}
        <div class="card-overlay" x-cloak x-show="spinner" x-transition>
          {% theme_render_rc 'components/atoms/spinner', classes: 'w-8 h-8' %}
        </div>
      </button>
      <hr x-show="currentPage < totalPages" class="border-0 border-t -mt-0.5 relative -z-10 -top-5">
    </div>
  </section>
{% endif %}
