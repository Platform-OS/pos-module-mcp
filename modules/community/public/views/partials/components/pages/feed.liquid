---
metadata:
  name: Feed
  params:
    current_profile: {}
    user: {}
    context: {}
    list: []
    page: 1
    frame: false
    uuid: null
    feed_type:
      - private
      - public
---


{% liquid
  assign context = context | default: params.context
  assign current_profile = current_profile | default: params.current_profile
  assign user = user | default: params.user
  assign list = list | default: params.list
  assign page = page | default: params.page | to_positive_integer: 1
  assign feed_type = feed_type | default: params.feed_type
  assign uuid = uuid | default: params.uuid
%}



{% liquid
  if uuid == blank and user.id == current_profile.id and frame != true
    render 'modules/community/migrated/post/form', id: 'pos-community-post-new', target_entity: current_profile, author: current_profile
  endif
%}

{% unless frame %}<section class="pos-app" id="pos-community-feed-posts">{% endunless %}
  {% if list.total_entries > 0 %}
    {% liquid
      for activity in list.results
        function can_reply = 'modules/user/helpers/can_do', requester: current_profile, do: 'reply', entity: activity.payload['modules/community/post'], access_callback: 'modules/community/can/posts'
        theme_render_rc 'components/organisms/feed-entry', payload: activity.payload, current_profile: current_profile, context: context, can_comment: can_reply
      endfor
    %}
  {% endif %}

  {% if list.total_entries == 0 and current_profile.id != user.id %}
    {% capture card_content %}
      <div class="container bg-panel w-full h-auto">
        <div class="flex flex-col md:flex-row items-center justify-evenly gap-4 p-6">
          <div class="border-r pr-4">
            {% theme_render_rc 'components/atoms/heading', content: "It looks like there is no activity here yet.", level: 4 %}
            <p>
              This user hasn't shared any updates or interactions. Check back later, or explore their profile for more
              information.
            </p>
          </div>
          <svg data-icon="search" {{ attrs | html_safe }} class="h-10 w-10 fill-current " viewBox="0 0 24 24" fill="none">
            <path d="M23.245 23.996a.743.743 0 01-.53-.22L16.2 17.26a9.824 9.824 0 01-2.553 1.579 9.766 9.766 0 01-7.51.069 9.745 9.745 0 01-5.359-5.262c-1.025-2.412-1.05-5.08-.069-7.51S3.558 1.802 5.97.777a9.744 9.744 0 017.51-.069 9.745 9.745 0 015.359 5.262 9.748 9.748 0 01.069 7.51 9.807 9.807 0 01-1.649 2.718l6.517 6.518a.75.75 0 01-.531 1.28zM9.807 1.49a8.259 8.259 0 00-3.25.667 8.26 8.26 0 00-4.458 4.54 8.26 8.26 0 00.058 6.362 8.26 8.26 0 004.54 4.458 8.259 8.259 0 006.362-.059 8.285 8.285 0 002.594-1.736.365.365 0 01.077-.076 8.245 8.245 0 001.786-2.728 8.255 8.255 0 00-.059-6.362 8.257 8.257 0 00-4.54-4.458 8.28 8.28 0 00-3.11-.608z"/>
          </svg>
        </div>
      </div>
    {% endcapture %}
    {% liquid
      assign card_params = null | hash_merge: content: card_content, classes: 'text-center', variant: 'highlighted'
      theme_render_rc 'components/atoms/card', params: card_params
    %}
  {% endif %}

  {% liquid
    if uuid == blank
      if list.total_entries < 7 and feed_type == 'private'
        theme_render_rc 'components/organisms/feed_welcome_message', current_profile: current_profile
      endif

      if list.has_next_page
        assign loadmore_url = '/my/more_feed.frame'
        if user.id != current_profile.id
          assign loadmore_url = '/profile.frame/feed/' | append: user.slug
        endif
      endif
    endif
  %}

  {% if list.has_next_page and loadmore_url %}
    <button
      id="pos-community-load-feed-more"
      class="pos-button"
      data-load-content="{{ loadmore_url }}?page={{ page | plus: 1 }}"
      data-load-where="last"
      data-load-target="#pos-community-feed-posts"
      disabled
    >{{ 'modules/community/app.show_more' | t }}</button>
  {% endif %}
{% unless frame %}</section>{% endunless %}