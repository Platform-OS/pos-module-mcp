{% liquid
  if payload.attributed_to

    if payload.attributed_to.type == 'collection'
      assign urls = '[]' | parse_json
      for item in payload.attributed_to.items
        function url = 'modules/community/activities/html/a', object: item, namespace: namespace, class: null, type: null, role: null
        assign urls = urls | add_to_array: url
      endfor

      assign urls = urls | join: ", "
    else
      function url = 'modules/community/helpers/link_to', object: payload.attributed_to, namespace: namespace
    endif

  else
    function url = 'modules/community/helpers/link_to', object: payload.target, namespace: namespace
  endif

  if payload.object.name
    assign status = payload.object.name | t
  endif
%}

{{ payload.object.name | t: url: url,
    target: payload.target.type,
    target_id: payload.target.id,
    target: payload.target,
    target_type: payload.target.type,
    status: status,
    urls: urls,
    scope: 'modules/community/activities.types.status_created'
}}
