{% liquid
  function profile = 'modules/user/queries/profiles/find', id: event.invited_profile_id, uuid: null, user_id: null, first_name: null, last_name: null
  # platformos-check-disable MissingPartial
  function object = 'modules/community/commands/authentication_links/create', email: profile.user.email, host: context.location.host
  # platformos-check-enable MissingPartial

  function group = 'modules/community/queries/groups/find', id: event.group_id, current_profile: null
  hash_assign object['group'] = group

  function member = 'modules/user/queries/profiles/find', id: event.inviting_profile_id, uuid: null, user_id: null, first_name: null, last_name: null
  hash_assign object['member'] = member

  function email = 'modules/community/commands/emails/group_invite', object: object
%}
