{% liquid
  assign notified_ids = '[]' | parse_json | add_to_array: event.event_object.owner.profile.id

  function audience = 'modules/community/commands/audience/build'
  hash_assign audience['notifications']['profile'] = notified_ids

  assign notification_title = 'modules/community/push_notifications.event_deleted.title' | t
  assign notification_body = 'modules/community/push_notifications.event_deleted.body' | t: event: event.event_object.name
  assign url = 'https://' | append: context.location.host | append: '/events'
  assign push_notification = {"title": notification_title, "body": notification_body, "url": url}

  function publish = 'modules/community/commands/activities/publish_to_many', uuid: event.uuid, audience: audience, at: null, notification: push_notification
%}
