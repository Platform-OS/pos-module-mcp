{% liquid
  assign c = '{ "errors": {}, "valid": true }' | parse_json

  if object.email == blank
    function c = 'modules/core/validations/email', c: c, object: object, field_name: 'email', key: null
  else
    graphql emails_count = 'modules/community/users/emails_count', email: object.email | dig: 'users', 'total_entries'
    if emails_count > 0
      # platformos-check-disable TranslationKeyExists
      assign message = 'app.errors.taken' | t
      # platformos-check-enable TranslationKeyExists
      function c = 'modules/core/helpers/register_error', contract: c, field_name: 'email', message: message, key: null
    endif
  endif

  function c = 'modules/core/validations/presence', c: c, object: object, field_name: 'password', key: 'modules/core/validation.blank'
  function c = 'modules/core/validations/password_complexity', c: c, object: object, field_name: null, maximum: null, minimum: null

  hash_assign object['valid'] = c.valid
  hash_assign object['errors'] = c.errors

  return object
%}
