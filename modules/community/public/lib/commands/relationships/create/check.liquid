{% liquid
  assign c = '{ "errors": {}, "valid": true }' | parse_json

  # this is disgusting
  # platformos-check-disable TranslationKeyExists
  assign relationship_names = 'modules/community/relationships.type' | t | parse_json
  # platformos-check-enable TranslationKeyExists

  unless relationship_names contains object.name
    # platformos-check-disable DeprecatedTag
    include 'modules/community/helpers/register_error', contract: c, field_name: 'name', key: 'modules/core/validation.array.not_included', message: null
    # platformos-check-enable DeprecatedTag
  endunless

  function c = 'modules/core/validations/presence', c: c, object: object, field_name: 'l_id', key: 'modules/core/validation.blank'
  function c = 'modules/core/validations/presence', c: c, object: object, field_name: 'r_id', key: 'modules/core/validation.blank'
  function c = 'modules/core/validations/presence', c: c, object: object, field_name: 'created_by_id', key: 'modules/core/validation.blank'

  hash_assign object['valid'] = c.valid
  hash_assign object['errors'] = c.errors

  return object
%}
