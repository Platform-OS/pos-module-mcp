{% liquid
  function object = 'modules/community/commands/relationships/delete/build', object: object
  function object = 'modules/community/commands/relationships/delete/check', object: object

  if object.valid and skip_execution != true
    function object = 'modules/core/commands/execute', mutation_name: 'modules/community/relationships/delete' object: object, selection: 'record_delete'

    if object.valid
      assign event_payload = object | hash_merge: relationship_id: object.id
      function _ = 'modules/core/commands/events/publish', type: 'relationship_deleted', object: event_payload, delay: 0, max_attempts: null
    endif
  endif

  return object
%}
