{% liquid
  function relations = 'modules/community/queries/relationships/search_by_right', name: "membership", r_id: group.id, approved: false, l_id: null, not_l_id: null, accepted: null, include_related: null
  
  for relation in relations.results
    if relation.r_accepted_at == null
      assign relation_object = relation | parse_json
      hash_assign relation_object["r_accepted_at"] = 'now' | to_time | json

      function _ = 'modules/community/commands/relationships/update', object: relation_object
    endif
  endfor

  return
%}
