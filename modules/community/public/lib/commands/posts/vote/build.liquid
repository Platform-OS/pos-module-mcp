{% case object.type %}
{% when 'up' %}
  {% assign object = {"id": object.id, "upvote_profile_id_append": profile.id, "downvote_profile_id_remove": profile.id} %}
{% when 'down' %}
  {% assign object = {"id": object.id, "upvote_profile_id_remove": profile.id, "downvote_profile_id_append": profile.id} %}
{% when 'clear' %}
  {% assign object = {"id": object.id, "upvote_profile_id_remove": profile.id, "downvote_profile_id_remove": profile.id} %}
{% endcase %}

{% liquid
  hash_assign object['profile_id'] = profile.id
  hash_assign object['owner_id'] = post.creator_id
  return object
%}
