{% liquid
  function slug = 'modules/community/helpers/generate_slug', title: object.title, id: object.id

  assign tags = object.tags | downcase | split: ',' | uniq
  assign slugged_tags = '' | split: ','

  for tag in tags
    assign slugged_tag = tag | slugify
    assign slugged_tags << slugged_tag
  endfor

  assign edited_at = object.edited_at
  assign object = {"id": object.id, "title": object.title, "body": object.body, "group_id": object.group_id, "tags": slugged_tags, "embeded_media": object.embeded_media, "upvote_profile_ids": object.upvote_profile_ids, "downvote_profile_ids": object.downvote_profile_ids, "accepted_post_id": object.accepted_post_id, "slug": slug}

  if edited_at != blank
    hash_assign object['edited_at'] = edited_at
  endif
  return object
%}
