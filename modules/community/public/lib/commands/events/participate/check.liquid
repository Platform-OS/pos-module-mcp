{% liquid
  assign c = '{ "errors": {}, "valid": true }' | parse_json

  function c = 'modules/core/validations/presence', c: c, object: object, field_name: 'l_id', key: 'modules/core/validation.blank'
  function c = 'modules/core/validations/presence', c: c, object: object, field_name: 'r_id', key: 'modules/core/validation.blank'
  function c = 'modules/core/validations/presence', c: c, object: object, field_name: 'created_by_id', key: 'modules/core/validation.blank'
  function c = 'modules/core/validations/presence', c: c, object: object, field_name: 'l_accepted_at', key: 'modules/core/validation.blank'
  function c = 'modules/core/validations/presence', c: c, object: object, field_name: 'r_accepted_at', key: 'modules/core/validation.blank'
  function c = 'modules/core/validations/presence', c: c, object: object, field_name: 'name', key: 'modules/core/validation.blank'
  assign membership_types = '["event:going", "event:maybe", "event:not-going"]' | parse_json
  function c = 'modules/core/validations/included', c: c, object: object, field_name: 'name', array: membership_types, key: null, value: null
  function c = 'modules/core/validations/equal', c: c, field_name: 'type', given: object.type, expected: 'relationship', key: null, message: null, not_verbose: null

  hash_assign object['valid'] = c.valid
  hash_assign object['errors'] = c.errors

  return object
%}
