{% liquid
  if audience == blank
    log 'Audience cannot be empty', type: 'WARN'
    return null
  endif

  for target in audience
  assign feeds = target[1]
  assign type = target[0]

    for feed in feeds
      assign ids = feed[1]
      if feed[0] == 'profile'
        assign feed_name = 'user' | append: '-' | append: type
      else
        assign feed_name = feed[0] | append: '-' | append: type
      endif

      if ids != empty
        if feed_name == 'user-notifications'
          function _publish = 'modules/community/commands/activities/publish', uuid: uuid, type: feed_name, ids: ids, at: at, notification: notification
        else
          function _publish = 'modules/community/commands/activities/publish', uuid: uuid, type: feed_name, ids: ids, at: at
        endif
      endif
    endfor

  endfor

  return true
%}
