{% liquid
  function object_owner = 'modules/community/commands/groups/leave/build', group: group, profile: profile, type: 'owner'
  function object_owner = 'modules/community/commands/groups/leave/check',  object: object_owner

  function object_member = 'modules/community/commands/groups/leave/build', group: group, profile: profile, type: 'member'
  function object_member = 'modules/community/commands/groups/leave/check',  object: object_member

  assign can_delete_membership = true
  if object_owner.error_reason != blank
    assign can_delete_membership = false
  endif

  if object_owner.valid
    function object_owner = 'modules/community/commands/relationships/delete', object: object_owner, skip_execution: null
    assign event_payload = null | hash_merge: l_id: profile.id, r_id: group.id, relationship_id: object_owner.id
    function _ = 'modules/core/commands/events/publish', type: 'relationship_deleted', object: event_payload, delay: 0, max_attempts: null
  endif

  if object_member.valid and can_delete_membership
    function object_member = 'modules/community/commands/relationships/delete', object: object_member, skip_execution: null
    assign event_payload = null | hash_merge: l_id: profile.id, r_id: group.id, relationship_id: object_member.id
    function _ = 'modules/core/commands/events/publish', type: 'relationship_deleted', object: event_payload, delay: 0, max_attempts: null
  endif

  if object_owner.valid
    return object_owner
  elsif object_member.valid
    return object_member
  else
    return object_owner
  endif
%}
