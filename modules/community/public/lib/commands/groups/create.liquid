{%  liquid
  function object = 'modules/community/commands/groups/create/build', object: object
  function object = 'modules/community/commands/groups/create/check', object: object
  if object.valid
    function object = 'modules/core/commands/execute', mutation_name: 'modules/community/groups/create', object: object, selection: 'record'

    assign event_payload = null | hash_merge: group_id: object.id, creator_id: owner_id
    function _ = 'modules/core/commands/events/publish', type: 'group_created', object: event_payload, delay: 0, max_attempts: null
  endif

  return object
%}
