{% comment %}group{% endcomment %}
{% liquid
  assign object = '{"id":7889, "name": "My group", "type":"group"}' | parse_json

  assign expected = '/groups/my-group-7889'
  function url = 'modules/community/helpers/link_to', object: object
  # platformos-check-disable DeprecatedTag
  include 'modules/tests/assertions/equal', contract: contract, field_name: 'group', given: url, expected: expected
  # platformos-check-enable DeprecatedTag

  assign expected = '/groups/7889/edit'
  function url = 'modules/community/helpers/link_to', object: object, action: 'edit'
  # platformos-check-disable DeprecatedTag
  include 'modules/tests/assertions/equal', contract: contract, field_name: 'group', given: url, expected: expected
  # platformos-check-enable DeprecatedTag

  assign expected = '/admin/groups/7889/edit'
  function url = 'modules/community/helpers/link_to', object: object, action: 'edit', namespace: 'admin'
  # platformos-check-disable DeprecatedTag
  include 'modules/tests/assertions/equal', contract: contract, field_name: 'group', given: url, expected: expected
  # platformos-check-enable DeprecatedTag
%}

