{% liquid
  if r_id == blank
    log 'Something went wrong. Right-ID cannot be blank.', type: 'ERROR'
    return null
  endif

  if name == blank
    log 'Something went wrong. Name cannot be blank.', type: 'ERROR'
    return null
  endif

  assign limit = limit | default: 100 | plus: 0
  assign pagef = pagef | default: 1 | plus: 0

  assign relation_tables = '["modules/community/group", "modules/community/post", "modules/community/event", "modules/user/profile"]' | parse_json
  graphql r = 'modules/community/relationships/search', limit: limit, page: pagef, name: name, l_id: l_id, r_id: r_id, not_l_id: not_l_id, include_related: include_related, accepted: accepted, approved: approved, relation_tables: relation_tables
  return r.records
%}
