{% liquid
  if l_id == blank and r_id == blank
    log "ERROR: no left and right, you must pass one"
    return null
  endif

  graphql r = 'modules/community/relationships/full_count', name: name, l_id: l_id, r_id: r_id
  # platformos-check-disable DeprecatedTag
  include 'modules/community/helpers/handle_graphql_response', r: r, name: 'queries/relationships/count'
  # platformos-check-enable DeprecatedTag

  return r.records
%}
