{% liquid
  if not_ids == blank
    assign not_ids = null
  endif

  graphql r = 'modules/user/profiles/search', limit: limit, uuid: uuid, id: id, ids: ids, user_id: user_id, not_ids: not_ids, roles: roles, query: query, sort: sort, page: page, with_avatar: with_avatar, with_user: with_user, with_profile_cover: with_profile_cover

  assign records = r.records
  assign profiles = '[]' | parse_json
  for profile in records.results
    function slug = 'modules/user/helpers/profiles/slugs/build', profile: profile, current_profile: null
    hash_assign profile['properties']['slug'] = slug
    assign p = profile | hash_merge: profile.properties

    assign profiles = profiles | array_add: p
  endfor
  hash_assign records['results'] = profiles

  # platformos-check-disable UnreachableCode
  # platformos-check-disable DeprecatedTag
  include 'modules/community/helpers/handle_graphql_response', r: r, name: 'queries/profiles/search'
  # platformos-check-enable DeprecatedTag
  # platformos-check-enable UnreachableCode
  return r.records
%}

