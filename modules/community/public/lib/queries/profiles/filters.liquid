{% assign sort_options = {"created_at_desc": {"created_at": {"order": "DESC"}}, "created_at_asc": {"created_at": {"order": "ASC"}}, "first_name_desc": {"properties": {"name": "first_name", "order": "DESC"}}, "first_name_asc": {"properties": {"name": "first_name", "order": "ASC"}}} %}
  {% liquid
    assign filters = '{}' | parse_json
    hash_assign filters['page'] = params.page | to_positive_integer: 1
    hash_assign filters['keyword'] = params.keyword | default: '' | strip
    hash_assign filters['sort_by'] = params.sort_by | default: default_sort_by | default: 'first_name_asc'
    hash_assign filters['sort'] = sort_options[filters.sort_by]
    hash_assign filters['status'] = params.status
    hash_assign filters['roles'] = params.roles
    if filters.roles == blank
      function roles = 'modules/user/queries/roles/custom'
      hash_assign filters['roles'] = roles
    endif

    return filters
  %}
