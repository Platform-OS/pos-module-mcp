{% assign result = '[]' | parse_json %}


{% comment %} Welcome text {% endcomment %}

{% capture welcome_widget %}
  <div class="py-6 w-full">
  {% liquid
    assign message = "Welcome " | append: context.exports.current_profile.first_name | append: ","
    theme_render_rc 'components/atoms/heading', content: message, level: 2, classes: 'py-4'
    theme_render_rc 'components/atoms/heading', content: "Check and manage the site to provide great community experience for your users.", level: 4, classes: 'pb-8'
  %}
  </div>
{% endcapture %}
{% liquid
  assign widget = null | hash_merge: content: welcome_widget, id: 'welcome_widget', weight: 0
  assign result = result | add_to_array: widget
%}


{% comment %} Groups widget {% endcomment %}

{% function total_groups = 'modules/community/queries/groups/count' %}
{% capture groups_content %}
  <div class="flex flex-col justify-between h-full">
    <div>
      <div class="uppercase">Groups</div>
      <div class="font-bold">{{total_groups}}</div>
      <br/>
    </div>
    <div>
      <hr>
      <div class="flex justify-end">
        {% theme_render_rc 'components/atoms/button', weight: 'secondary', href: '/admin/community/groups', content: 'View' %}
      </div>
    </div>
  </div>
{% endcapture %}

{% capture groups_widget %}
  {% theme_render_rc 'components/atoms/card', content: groups_content, classes: 'w-full lg:w-80' %}
{% endcapture %}
{% liquid
  assign widget = null | hash_merge: content: groups_widget, id: 'groups_widget', weight: 1
  assign result = result | add_to_array: widget
%}


