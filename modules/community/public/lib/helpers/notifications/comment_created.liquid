{% liquid
  unless payload.object.target_activity_uuid
    log 'target_activity_uuid is missing from comment payload', type: 'ERROR'
    return
  endunless

  function activities = 'modules/community/queries/activities/one', uuid: payload.object.target_activity_uuid
  assign activity = activities.results.first.payload
  if activity
    hash_assign activity['comment_id'] = payload.comment_id
    function target_url = 'modules/community/activities/html/a', object: activity, type: 'activity', class: 'text-interactive-text', namespace: null, role: null
    assign message = payload.type | t: actor: payload.actor.name, target: payload.target.name, target_url: target_url, object_url: payload.object.url, type: payload.target.type, scope: 'modules/community/activities.types', target_url: target_url
  else
    assign message = ''
  endif

  return message
%}