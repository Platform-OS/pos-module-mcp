{% comment %} create_api_token GraphQL queries go below {% endcomment %}
{% assign token = '' | uuid %}
{% graphql r, token: token %}
mutation ($token: String!) {
  constant_set(name: "API_TOKEN", value: $token){
    name
    value
  }
}
{% endgraphql %}
{% log r, type: 'migrations/create_api_token' %}
