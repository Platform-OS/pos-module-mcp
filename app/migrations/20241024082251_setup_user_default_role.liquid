{% liquid
  function result = 'modules/core/commands/variable/set', name: 'USER_DEFAULT_ROLE', value: 'member'
  log result, type: 'setup_user_default_role result'
%}
{% graphql g %}
  mutation m{
    users_update_all(
      all_users: true
      user: {
        properties: { name: "roles", value_array: ["member"]}
      }
    ){
      count
    }
  }
{% endgraphql %}
        
